{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zero-trust",
  "main": "api/platform-router.mjs",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "zero-trust", "database_id": "SET_IN_CLOUDFLARE" }],
  "observability": { "enabled": true }
}
